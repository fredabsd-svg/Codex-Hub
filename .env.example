# Codex Hub — variáveis de ambiente de DESENVOLVIMENTO.
# Copie para `.env` (que está no .gitignore). Nenhum segredo real deve entrar neste arquivo.
#
# Importante: o aplicativo NÃO precisa de nenhuma variável para funcionar. As chaves de API
# são informadas na interface e guardadas no armazenamento protegido do sistema
# (Electron safeStorage). As variáveis abaixo existem apenas para desenvolvimento e testes.

# --- Diagnóstico ---
# Nível de log do processo principal: error | warn | info | debug
CODEX_HUB_LOG_LEVEL=info
# Escreve o log também no stdout do processo (útil em `npm run dev`)
CODEX_HUB_LOG_STDOUT=true

# --- Codex CLI ---
# Caminho explícito para o executável do Codex CLI, quando não estiver no PATH.
# Windows:  CODEX_HUB_CODEX_PATH=C:\Users\voce\AppData\Local\Programs\codex\codex.exe
# Linux/macOS: CODEX_HUB_CODEX_PATH=/usr/local/bin/codex
CODEX_HUB_CODEX_PATH=

# --- Testes com credenciais reais (npm run test:live) ---
# Sem estas variáveis a suíte "live" é ignorada explicitamente (não é marcada como sucesso).
# NUNCA preencha estes valores no .env.example.
OPENROUTER_API_KEY=
# Modelo usado nos testes live (precisa existir na conta):
OPENROUTER_LIVE_MODEL=
# Endpoint compatível local para testes (ex.: http://127.0.0.1:11434/v1)
COMPATIBLE_BASE_URL=
